// SPDX-License-Identifier: Apache-2.0
// The Dogwood policy for Codex in the box. Box denies every operation it checks unless a permit
// matches, and a matching forbid overrides any permit. A path under the operator's home
// (/home/agent in the guest) starts with "~" here.
//
// Box's reference for each action and field:
// https://github.com/strands-agents/box/blob/main/docs/user/policy/actions.md

// ── The model ────────────────────────────────────────────────────────────────
// Connect to bedrock-runtime in us-east-1, and send it requests. This is the only host Codex
// reaches; the egress gateway adds the Bedrock API key to each request.
@id("model_connect")
permit (principal, action == Box::Action::"net:connect", resource)
when { context.input.host == "bedrock-runtime.us-east-1.amazonaws.com" && context.input.port == 443 };

@id("model_request")
permit (principal, action == Box::Action::"http:request", resource)
when { context.input.host == "bedrock-runtime.us-east-1.amazonaws.com" };

// ── The shell and the project ────────────────────────────────────────────────
// Run any command Strands Shell implements. Each file a command touches is still its own decision.
// `python3` here is the Shell's own interpreter (Monty), and its exit status is the workload's to
// set: a shell function named `python3` can return 0. So the rules below that need a test result
// read the tests run as a host program instead.
@id("shell_commands")
permit (principal, action == Box::Action::"shell:exec", resource);

// Run the project's tests, and only them, as a host program: `python3.12 test_calc.py` in the
// project directory. The Shell doesn't implement `python3.12`, so this is a shell:spawn, and Box
// records the program's own exit status. program_path is the file with every link resolved, and
// cwd is a full path, unlike the "~" paths on fs:*. A host program's file operations raise no
// fs:* decision, so box.toml's [tool.tests] table runs it read-only on the project with .env
// denied. Every other host program has no permit, so none runs.
@id("run_tests")
permit (principal, action == Box::Action::"shell:spawn", resource)
when {
  context.input.program_path == "/usr/bin/python3.12" &&
  context.input has arg1 && context.input.arg1 == "test_calc.py" &&
  context.input.arg_count == 1 &&
  context.input.cwd == "/home/agent/project"
};

@id("project_read")
permit (principal, action == Box::Action::"fs:read", resource)
when { context.input.path == "~/project" || context.input.path like "~/project/*" };

@id("project_write")
permit (principal, action == Box::Action::"fs:write", resource)
when { context.input.path like "~/project/*" };

// Agents redirect output to /dev/null all the time.
@id("dev_null")
permit (principal, action in [Box::Action::"fs:read", Box::Action::"fs:write"], resource)
when { context.input.path == "/dev/null" };

// ── What stays refused whatever the permits say ──────────────────────────────
@id("no_env")
@description("The .env file holds credentials the agent must not read.")
forbid (principal, action == Box::Action::"fs:read", resource)
when {
  context.input.path == "~/project/.env" &&
  context.input.operation == Box::FsReadOperation::"read_content"
};

@id("no_deletes")
@description("This agent writes the project and runs commands in it. It deletes nothing.")
forbid (principal, action == Box::Action::"fs:delete", resource);

// The MicroVM's execution role is served at 169.254.169.254 through Firecracker MMDS, and no
// in-guest block works for a process outside the box (docs/TRUST.md). Inside the box every
// connection goes through the egress gateway, so this rule refuses the address by name and by
// the address the gateway resolved.
@id("metadata_hosts")
@description("Refuse the instance metadata service by name, before resolution.")
forbid (principal, action == Box::Action::"net:connect", resource)
when { context.input.host == "169.254.169.254" || context.input.host == "fd00:ec2::254" };

@id("metadata_addresses")
@description("Refuse link-local and cloud metadata addresses, on the address resolution pinned.")
forbid (principal, action == Box::Action::"net:connect", resource)
when {
  (context.input has ip4 && context.input.ip4 like "169.254.*") ||
  (context.input has ip6 && (
    context.input.ip6 == "fd00:ec2::254" ||
    context.input.ip6 like "fe8*" || context.input.ip6 like "fe9*" ||
    context.input.ip6 like "fea*" || context.input.ip6 like "feb*"))
};

// ── The tests ────────────────────────────────────────────────────────────────
// The tests decide whether the work is done, so Codex may run them and never change them. The
// policy permits no fs:move, so a `mv` is refused already; fs:move here keeps the tests frozen
// if a later edit permits moves, because Box decides a move once for each of its two paths.
@id("tests_are_frozen")
@description("The tests are fixed: change calc.py until test_calc.py passes, and leave test_calc.py and tests/ as they are.")
forbid (principal, action in [Box::Action::"fs:write", Box::Action::"fs:move"], resource)
when {
  context.input.path == "~/project/test_calc.py" ||
  context.input.path == "~/project/tests" ||
  context.input.path like "~/project/tests/*"
};

// ── Rules over time ──────────────────────────────────────────────────────────
// Box keeps every request and response in one history, so a rule can depend on what happened
// before. Each rule below reads the test run's shell:spawn response, which carries the exit
// status Box saw, pinned to the one command run_tests permits.

// RELEASE.md may be written only after a test run that exited 0 in the last 15 minutes, with no
// file written since. An edit after the passing run closes the gate until the tests pass again,
// and so does writing RELEASE.md itself, so each release needs its own passing run. A redirect
// to /dev/null is a file write too, and the only one that leaves the gate open.
@id("release_after_green_tests")
@description("Write RELEASE.md only after `python3.12 test_calc.py` exits 0, with no project file written since.")
forbid (principal, action == Box::Action::"fs:write", resource)
when { context.input.path == "~/project/RELEASE.md" }
unless temporal {
  !(Box::Action::"fs:write"::response{ input.path: _ } &&
    !Box::Action::"fs:write"::response{ input.path: "/dev/null" })
    since within 15m
  Box::Action::"shell:spawn"::response{ input.program_path: "/usr/bin/python3.12", input.arg1: "test_calc.py", input.arg_count: 1, input.cwd: "/home/agent/project", output.status: 0 }
};

// After 10 test runs that failed in the last hour, Codex is going in circles: refuse every
// project write until the failures are an hour old, so a person can look first. A failed run is
// any exit status but 0, so a run that hangs and is killed (128 plus the signal) counts too.
@id("stall_brake")
@description("The tests failed 10 times in the last hour. Stop and report what is failing; project writes resume when the failures are an hour old.")
forbid (principal, action == Box::Action::"fs:write", resource)
when { context.input.path like "~/project/*" }
when temporal {
  exists (fails: Long). (
    (count for (t: Timepoint). where (
      formerly within 1h (
        Box::Action::"shell:spawn"::response{ input.program_path: "/usr/bin/python3.12", input.arg1: "test_calc.py", input.arg_count: 1, input.cwd: "/home/agent/project" } &&
        !Box::Action::"shell:spawn"::response{ output.status: 0 } && tp(t)
      )
    )) == fails
    && fails >= 10
  )
};

// Codex may send bedrock-runtime 400 requests in any hour. The count reads ::request, which Box
// records for every attempt before it decides the next one, so the cap admits exactly 400. An
// attempt this rule refuses still counts until it's an hour old.
@id("model_call_budget")
@description("Codex has sent bedrock-runtime 400 requests in the last hour, the most this box allows.")
forbid (principal, action == Box::Action::"http:request", resource)
when { context.input.host == "bedrock-runtime.us-east-1.amazonaws.com" }
when temporal {
  exists (calls: Long). (
    (count for (t: Timepoint). where (
      formerly within 1h (
        Box::Action::"http:request"::request{ input.host: "bedrock-runtime.us-east-1.amazonaws.com" } && tp(t)
      )
    )) == calls
    && calls > 400
  )
};
